# FamilyCircle configuration for compose.yaml (Portainer: Stacks → Environment variables).
# Copy to .env and adjust. Never commit the real .env.

# Versioned server image. Use a fixed version, never "latest".
# Official images: ghcr.io/purepixeldev/familycircle (published by the release workflow; available from the first release on).
# Before that: import an image archive in Portainer (scripts/build-image-archive.sh) and use FC_IMAGE=familycircle:0.3.0
FC_IMAGE=ghcr.io/purepixeldev/familycircle:0.3.0

# Port on the Docker host. Web app: http://<server-ip>:9092
FC_HTTP_PORT=9092

# Database password (also used by the database container on first start). Required, no default.
# Use a long random value, e.g.: openssl rand -hex 32
# Alternatively mount it as a file/secret and set FC_DB_PASSWORD_FILE for the server (see INSTALL_PORTAINER.md).
# Changing it later requires changing it inside PostgreSQL as well (see BACKUP_RESTORE.md).
FC_DB_PASSWORD=

# External address as seen by browsers and the Android app.
# LAN test:            http://192.168.1.10:9092
# Behind HTTPS proxy:  https://family.example.org   (enables Secure cookies + HSTS)
FC_PUBLIC_URL=

# Reverse proxy (e.g. Nginx Proxy Manager) address whose X-Forwarded-For header is trusted.
# Use ONLY the proxy's own address – the server logs it once ("set FC_TRUSTED_PROXIES to this address").
# Never a whole Docker range: clients inside it could then fake their address.
FC_TRUSTED_PROXIES=

# MapLibre style. Empty = OpenFreeMap "liberty" (https://openfreemap.org, OpenStreetMap data, no key).
FC_MAP_STYLE_URL=
# Additional origins the browser may load map tiles/fonts from (comma separated), if your style uses them.
FC_MAP_EXTRA_ORIGINS=

# Optional fixed setup code for the first-run wizard. Empty = random code printed in the container log.
FC_SETUP_TOKEN=

# debug | info | warn | error  (locations and tokens are never logged)
FC_LOG_LEVEL=info

# Database image. Default postgis/postgis:17-3.5 is amd64 only.
# On ARM hosts (Raspberry Pi 4/5, ARM NAS) use: imresamu/postgis:17-3.5
# Never switch the PostgreSQL major version on an existing volume (see BACKUP_RESTORE.md).
FC_DB_IMAGE=
