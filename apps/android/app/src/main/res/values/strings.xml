    <!-- Permissions -->
    <string name="perm_title">Before you start</string>
    <string name="perm_intro">FamilyCircle only shares your location when you switch it on, and only with the family members you choose. You can pause it at any time.</string>
    <string name="perm_location_title">Your location</string>
    <string name="perm_location_body">So your family can see where you are, the app needs access to your location. Please choose \"Precise\" – with \"Approximate\" your family only sees roughly where you are (a few kilometres).</string>
    <string name="perm_location_button">Allow location access</string>
    <string name="perm_status_precise">Precise location allowed</string>
    <string name="perm_status_approximate">Only approximate location allowed – your family will see an area of a few kilometres.</string>
    <string name="perm_denied_settings">Location access was declined. You can allow it in the app settings under \"Permissions\".</string>
    <string name="perm_open_settings">Open app settings</string>
    <string name="perm_notif_title">Notifications (recommended)</string>
    <string name="perm_notif_body">While your location is shared, a notification shows it and lets you pause with one tap. Without this permission you would not see that sharing is on.</string>
    <string name="perm_notif_button">Allow notifications</string>
    <string name="perm_status_allowed">Allowed</string>
    <string name="perm_bg_title">Resume after a restart (optional)</string>
    <string name="perm_bg_body">Normally you need to open FamilyCircle once after your phone restarts. If you allow location access \"all the time\", sharing resumes on its own. FamilyCircle does not use this permission for anything else.</string>
    <string name="perm_bg_how">On the next screen choose \"%1$s\".</string>
    <string name="perm_bg_label_fallback">Allow all the time</string>
    <string name="perm_bg_needs_location">Allow location access first.</string>
    <string name="perm_bg_button">Allow all the time</string>
    <string name="perm_change_later">You can change all of this later in the settings.</string>

    <!-- Tracking modes -->
    <string name="mode_title">How often to share</string>
    <string name="mode_intro">These are targets – your phone may update less often to save battery.</string>
    <string name="mode_off">Off</string>
    <string name="mode_off_desc">Your location is not shared.</string>
    <string name="mode_saver">Battery saver</string>
    <string name="mode_saver_desc">About every 15 minutes or 250 m. Uses the least battery.</string>
    <string name="mode_balanced">Balanced</string>
    <string name="mode_balanced_desc">About every 2 minutes or 50 m. Good for every day.</string>
    <string name="mode_live">Live</string>
    <string name="mode_live_desc">About every 15 seconds. Uses a lot of battery and switches back to Balanced after 30 minutes.</string>

