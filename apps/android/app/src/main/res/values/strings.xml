    <!-- Unencrypted connection -->
    <string name="cleartext_banner_title">Unencrypted connection</string>
    <string name="cleartext_banner_body">This server is used over http://. Others on the same network could read your locations and your password. Use https:// whenever possible.</string>
    <string name="cleartext_dialog_title">Use an unencrypted connection?</string>
    <string name="cleartext_dialog_body">The address starts with http://. Everything – including your password and your locations – is sent without encryption. Only continue if this server is in your own home network and you trust that network.</string>
    <string name="cleartext_dialog_confirm">Use anyway</string>

