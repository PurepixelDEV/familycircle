<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional, requested separately and only used to resume sharing after a reboot, an app update
         or when Android ended the app (see tracking/BackgroundResume.kt). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Optional "Alarme immer sofort empfangen" (alerts/AlertService.kt): keeps the connection for
         family emergency alerts (SOS, "let my phone ring") open without Google push. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- SOS of a family member may show full screen on the lock screen (only if the user allows it). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Keeps the CPU awake while the phone rings for "let my phone ring" (alerts/Ringer.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for scanning the QR code that connects the app to the server (nothing is recorded). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional: lets the user exempt the app from battery optimisation (Settings → Diagnostics) so
         Android does not pause location sharing. Core function = continuous location sharing; the app
         is not distributed via Google Play. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- TODO(targetSdk 37): declare android.permission.ACCESS_LOCAL_NETWORK and request it at runtime
         before raising targetSdk (needed for servers in the local network). -->

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- allowBackup=false + explicit extraction rules: tokens and queued locations must never end up
         in a cloud backup or device-to-device transfer. -->
    <application
        android:name=".FamilyCircleApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyCircle"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FamilyCircle"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "In der App öffnen" on the web page of an invite/pairing link (docs/QR_FORMAT.md).
                 Custom scheme: the server's host is not known at build time, so no App Links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="familycircle" android:host="link" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.LocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <service
            android:name=".alerts.AlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Family emergency alerts: keeps the connection to the self-hosted family server open so that SOS alarms and requests to let this phone ring arrive immediately, without Google push. Switched on by the user (Settings: Alarme immer sofort empfangen)." />
        </service>

        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".tracking.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
